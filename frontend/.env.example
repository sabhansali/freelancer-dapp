REACT_APP_REOWN_PROJECT_ID=your_reown_project_id

# Copy the two addresses printed by `truffle migrate --reset`.
REACT_APP_DEX_TOKEN_A_ADDRESS=0xYourTokenAAddress
REACT_APP_DEX_TOKEN_B_ADDRESS=0xYourTokenBAddress

# Set the address printed by the local or Sepolia oracle migration.
REACT_APP_PRICE_CONSUMER_LOCAL_ADDRESS=0xYourLocalConsumerAddress
REACT_APP_PRICE_CONSUMER_SEPOLIA_ADDRESS=0xYourSepoliaConsumerAddress
REACT_APP_SEPOLIA_RPC_URL=https://rpc.sepolia.org
